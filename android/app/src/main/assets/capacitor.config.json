{
	"appId": "com.clashmusic.app",
	"appName": "Clash Music",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"StatusBar": {
			"overlaysWebView": false,
			"style": "DARK",
			"backgroundColor": "#0b0f19"
		},
		"CapacitorCookies": {
			"enabled": true
		},
		"SplashScreen": {
			"launchShowDuration": 1000,
			"launchAutoHide": true,
			"launchFadeOutDuration": 300,
			"backgroundColor": "#0b0f19",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		}
	}
}
